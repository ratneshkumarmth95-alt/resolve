datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Machine {
  id                   String         @id @default(uuid())
  name                 String
  type                 String
  location             String
  status               String         @default("healthy") // healthy, drifting, critical
  downtimeCostPerHr    Float          @default(10000)
  repairCost           Float          @default(1500)
  currentTemp          Float
  currentVibration     Float
  currentCurrentDraw   Float
  currentPressure      Float
  currentCycleTime     Float
  currentNoise         Float
  tempThreshold        Float
  vibrationThreshold   Float
  currentDrawThreshold Float
  pressureThreshold    Float
  cycleTimeThreshold   Float
  noiseThreshold       Float
  driftVelocity        Float          @default(0) // unit/hr drift slope
  timeToScreamSeconds  Int            @default(86400) // countdown in seconds
  breachMetric         String         @default("temperature")
  confidence           Float          @default(95.0)
  activeFault          String?        
  activeFaultStartTime DateTime?
  posX                 Int            @default(10)
  posY                 Int            @default(10)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  readings             Reading[]
  interventions        Intervention[]
}

model Reading {
  id          String   @id @default(uuid())
  machineId   String
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  temperature Float
  vibration   Float
  currentDraw Float
  pressure    Float
  cycleTime   Float
  noise       Float
}

model Intervention {
  id                     String    @id @default(uuid())
  machineId              String
  machine                Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  issueTitle             String
  description            String
  actionType             String    // Trigger Maintenance | Reduce Load | Reassign Shift | Order Part
  actionCost             Float     @default(500)
  timeSavedHrs           Float     @default(12)
  projectedCostIfIgnored Float     @default(50000)
  roi                    Float     @default(100)
  urgency                String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status                 String    @default("PENDING") // PENDING, EXECUTED, DISMISSED
  executedAt             DateTime?
  createdAt              DateTime  @default(now())
}
